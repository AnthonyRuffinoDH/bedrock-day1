# --- Slack ---
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# --- Cognito (M2M OAuth) ---
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_USER_POOL_ID=

# --- AgentCore ---
AGENT_URL=https://bedrock-agentcore.us-west-2.amazonaws.com/runtimes/.../invocations

# --- Transport ---
# Set to "true" to use WebSocket transport instead of HTTP streaming (falls back to HTTP on failure)
USE_WEBSOCKET=true
# Timeout in seconds for local MCP tool execution (harness side)
MCP_TOOL_TIMEOUT=30

# --- Harness Tuning (defaults shown) ---
THROTTLE_WINDOW_SEC=5
MAX_WARNINGS=3
WARNING_WINDOW_MIN=10
BAN_DURATION_MIN=60
THREAD_CONTEXT_LIMIT=20
